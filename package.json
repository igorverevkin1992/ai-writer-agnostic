{
  "name": "ai-writer-agnostic",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @aiw/server --filter @aiw/web dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && tsc -p tsconfig.json && pnpm -r typecheck",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "smoke": "tsx scripts/smoke.ts",
    "eval": "tsx scripts/eval.ts",
    "kb:check": "pnpm --filter @aiw/kb check",
    "seed-holes": "tsx scripts/seed-holes.ts",
    "pilot": "tsx scripts/pilot.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2",
    "@aiw/core": "workspace:*",
    "zod": "^4.6.5",
    "yaml": "^2.9.1",
    "@aiw/kb": "workspace:*"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
